# No API keys are required — UBA Air Data API and DWD Open Data are both
# unauthenticated public HTTP(S) endpoints. This file exists for optional
# local overrides only.

# Base URLs (override only if the upstream host changes)
UBA_API_BASE=https://www.umweltbundesamt.de/api/air_data/v3
DWD_OPENDATA_BASE=https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate

# Local storage
DATA_DIR=./data
MODELS_DIR=./models

# MLflow (local file-store by default; set to a server URI if you run one)
MLFLOW_TRACKING_URI=./mlruns

# API
API_HOST=0.0.0.0
API_PORT=8010
